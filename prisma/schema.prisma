generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookType {
  DIGITAL
  PHYSICAL
}

enum DigitalBookSource {
  URL
  FILE
}

enum PhysicalBookSource {
  OWNED
  RENTED
}

enum BookReadingStatus {
  READING
  COMPLETED
  PAUSED
  DROPPED
}

enum ReadListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ReadListRole {
  VIEWER
  EDITOR
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  password     String
  refreshToken String?

  books                 Book[]
  ratings               Rating[]
  readLists             ReadList[]
  readListMemberships   ReadListCollaborator[]
  savedReadLists        ReadListSave[]
  readListContributions ReadListBook[]         @relation("ReadListContributor")
  progress              BookProgress[]
  readingStats          ReadingStats?
  socialProfile         SocialProfile?
  rssSubscriptions      RssSubscription[]
  chatsAsFirst          ChatConversation[]     @relation("ChatFirstParticipant")
  chatsAsSecond         ChatConversation[]     @relation("ChatSecondParticipant")
  chatMessages          ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id          String  @id @default(cuid())
  title       String
  description String?
  author      String
  isbn        String?

  type BookType @default(PHYSICAL)

  publishedAt DateTime?
  coverUrl    String?

  totalPages Int?

  averageRating Float @default(0)
  ratingsCount  Int   @default(0)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  digitalBook  DigitalBook?
  physicalBook PhysicalBook?

  ratings       Rating[]
  readListBooks ReadListBook[]
  progress      BookProgress[]
  tags          BookTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model DigitalBook {
  id String @id @default(cuid())

  bookId String @unique
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  source DigitalBookSource @default(URL)

  url      String?
  filePath String?
  fileType String?
  fileSize Int?
}

model PhysicalBook {
  id String @id @default(cuid())

  bookId String @unique
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  address    String
  city       String
  country    String
  postalCode String?

  borrowedBy String?
  returnDate DateTime?
}

model ReadList {
  id          String             @id @default(cuid())
  title       String
  description String?
  coverUrl    String?            @db.VarChar(2048)
  visibility  ReadListVisibility @default(PRIVATE)
  revision    Int                @default(0)

  userId String
  owner  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items         ReadListBook[]
  collaborators ReadListCollaborator[]
  saves         ReadListSave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, title])
  @@index([userId])
  @@index([visibility, updatedAt(sort: Desc), id])
}

model ReadListBook {
  id              String  @id @default(cuid())
  readListId      String
  bookId          String?
  catalogProvider String? @db.VarChar(20)
  catalogId       String? @db.VarChar(100)
  catalogPreview  Json?
  position        Int
  note            String? @db.VarChar(1000)
  addedById       String?
  addedBy         User?   @relation("ReadListContributor", fields: [addedById], references: [id], onDelete: SetNull)

  readList ReadList @relation(fields: [readListId], references: [id], onDelete: Cascade)
  book     Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([readListId, bookId])
  @@unique([readListId, catalogProvider, catalogId])
  @@unique([readListId, position])
  @@index([bookId])
  @@index([addedById])
}

model ReadListCollaborator {
  readListId String
  userId     String
  role       ReadListRole @default(EDITOR)
  readList   ReadList     @relation(fields: [readListId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([readListId, userId])
  @@index([userId])
}

model ReadListSave {
  readListId String
  userId     String
  readList   ReadList @relation(fields: [readListId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([readListId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Rating {
  id String @id @default(cuid())

  value Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([bookId])
}

model BookProgress {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  currentPage Int @default(0)
  totalPages  Int @default(0)

  status             BookReadingStatus @default(READING) // reading, completed, paused, dropped
  progressPercentage Float             @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model Tag {
  id String @id @default(cuid())

  name String @unique

  books BookTag[]

  createdAt DateTime @default(now())
}

model BookTag {
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
}

model ReadingStats {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalBooksCompleted Int   @default(0)
  totalPagesRead      Int   @default(0)
  totalReadingTime    Int   @default(0)
  averageRating       Float @default(0)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastReadDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialProfile {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle          String           @unique @db.VarChar(30)
  displayName     String           @db.VarChar(80)
  bio             String           @default("") @db.VarChar(160)
  avatarUrl       String?          @db.VarChar(2048)
  websiteUrl      String?          @db.VarChar(2048)
  isPublic        Boolean          @default(false)
  personalizeFeed Boolean          @default(true)
  posts           SocialPost[]
  likes           SocialLike[]
  views           SocialPostView[]
  following       SocialFollow[]   @relation("Follower")
  followers       SocialFollow[]   @relation("Following")
  blocking        SocialBlock[]    @relation("Blocker")
  blockedBy       SocialBlock[]    @relation("Blocked")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isPublic, handle])
}

model SocialPost {
  id        String           @id @default(cuid())
  authorId  String
  author    SocialProfile    @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  content   String           @db.VarChar(280)
  tags      String[]         @default([])
  parentId  String?
  parent    SocialPost?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   SocialPost[]     @relation("Replies")
  likes     SocialLike[]
  views     SocialPostView[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([parentId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tags], type: Gin)
}

model SocialFollow {
  followerId  String
  followingId String
  follower    SocialProfile @relation("Follower", fields: [followerId], references: [userId], onDelete: Cascade)
  following   SocialProfile @relation("Following", fields: [followingId], references: [userId], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model SocialLike {
  userId    String
  postId    String
  user      SocialProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post      SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

model SocialPostView {
  userId    String
  postId    String
  user      SocialProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post      SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  updatedAt DateTime      @updatedAt

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, updatedAt(sort: Desc)])
}

model SocialBlock {
  blockerId String
  blockedId String
  blocker   SocialProfile @relation("Blocker", fields: [blockerId], references: [userId], onDelete: Cascade)
  blocked   SocialProfile @relation("Blocked", fields: [blockedId], references: [userId], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model RssSubscription {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String     @db.VarChar(2048)
  title         String     @db.VarChar(200)
  entries       RssEntry[]
  lastFetchedAt DateTime   @default(now())
  nextRefreshAt DateTime
  lastError     String?    @db.VarChar(100)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, url])
}

model RssEntry {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   RssSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  guidHash       String          @db.VarChar(64)
  title          String          @db.VarChar(300)
  summary        String          @db.VarChar(2000)
  url            String?         @db.VarChar(2048)
  tags           String[]        @default([])
  publishedAt    DateTime
  importedAt     DateTime        @default(now())
  readAt         DateTime?

  @@unique([subscriptionId, guidHash])
  @@index([subscriptionId, publishedAt(sort: Desc), id(sort: Desc)])
}

model ChatConversation {
  id           String        @id @default(cuid())
  firstUserId  String
  secondUserId String
  firstUser    User          @relation("ChatFirstParticipant", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser   User          @relation("ChatSecondParticipant", fields: [secondUserId], references: [id], onDelete: Cascade)
  lastSequence Int           @default(0)
  messages     ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, id])
  @@index([secondUserId, id])
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String           @db.Uuid
  sequence        Int
  content         String           @db.VarChar(4000)
  spoiler         Boolean          @default(false)
  quote           Json?
  bookPreviews    Json             @default("[]")
  bookReferences  Json             @default("[]")
  replyToId       String?
  replyTo         ChatMessage?     @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]    @relation("ChatReplies")
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderId, clientMessageId])
  @@index([senderId])
  @@index([replyToId])
}
