              { "key": "page", "value": "1" },
              { "key": "limit", "value": "10" }
            ] }
          }
        },
        {
          "name": "Get Profile Read Lists (403 hidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok when other user has default visible settings', function() { pm.expect(pm.response.code).to.equal(200); });"
