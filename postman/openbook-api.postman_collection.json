            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/profile/{{otherUserId}}/read-lists", "host": ["{{baseUrl}}"], "path": ["profile", "{{otherUserId}}", "read-lists"] }
          }
