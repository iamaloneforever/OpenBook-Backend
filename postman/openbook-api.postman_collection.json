{
  "info": {
    "name": "OpenBook API",
    "description": "Full API test suite for the OpenBook NestJS backend.\n\nRun Auth > Signup twice to populate accessToken/userId and otherAccessToken/otherUserId, then run any folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', function() { pm.expect(pm.response.code).to.equal(201); });",
                  "pm.test('returns user and token', function() {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('user');",
                  "  pm.expect(body.user).to.have.property('id');",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('userId', body.user.id);",
                  "  pm.environment.set('username', body.user.username);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"testuser_a_{{$timestamp}}\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
        },
        {
          "name": "Signup User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', function() { pm.expect(pm.response.code).to.equal(201); });",
                  "pm.test('returns user and token', function() {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('user');",
                  "  pm.expect(body.user).to.have.property('id');",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.environment.set('otherAccessToken', body.accessToken);",
                  "  pm.environment.set('otherUserId', body.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"testuser_b_{{$timestamp}}\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
        },
        {
          "name": "Login User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 ok', function() { pm.expect(pm.response.code).to.equal(201); });",
                  "pm.test('returns accessToken', function() {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{username}}\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 ok', function() { pm.expect(pm.response.code).to.equal(201); });",
                  "pm.test('message confirms logout', function() {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.message).to.include('Logged out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
