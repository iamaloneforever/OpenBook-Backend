{
	"name": "nest",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"{src,test}/**/*.{ts,mts}\" \"*.config.{ts,mts,mjs}\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node --enable-source-maps dist/main.js",
		"lint": "eslint \"{src,test}/**/*.{ts,mts}\" \"*.config.{ts,mts}\"",
		"typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript7.tsbuildinfo && tsc6 --noEmit --tsBuildInfoFile node_modules/.cache/typescript6.tsbuildinfo",
		"test": "vitest run",
		"test:e2e": "vitest run --config test/vitest-e2e.mts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:social": "vitest run --config test/vitest-social.mts",
		"lint:fix": "npm run lint -- --fix",
		"prisma:generate": "prisma generate",
		"pretest:e2e": "npm run build",
		"test:postman": "postman collection run postman/collections/openbook.postman_collection.json -e postman/environments/local.postman_environment.json --working-dir .",
		"test:chat": "vitest run --config test/vitest-chat.mts",
		"test:postman:catalog": "postman collection run postman/collections/public-books-live.postman_collection.json -e postman/environments/local.postman_environment.json --working-dir .",
		"test:read-list": "vitest run --config test/vitest-read-list.mts"
	},
	"dependencies": {
		"@nestjs/cache-manager": "^12.0.2",
		"@nestjs/common": "^12.3.2",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.3.2",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/mapped-types": "^12.0.0",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.3.2",
		"@nestjs/platform-socket.io": "12.3.2",
		"@nestjs/serve-static": "^12.1.1",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/websockets": "12.3.2",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@socket.io/redis-adapter": "8.3.0",
		"argon2": "^0.45.1",
		"cache-manager": "^7.2.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.3.0",
		"htmlparser2": "^12.0.0",
		"keyv": "^6.1.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"redis": "6.3.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"saxes": "^6.0.0",
		"socket.io": "4.8.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^12.0.11",
		"@nestjs/schematics": "^12.0.12",
		"@nestjs/testing": "^12.3.2",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.6",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.0.5",
		"dotenv": "^18.0.9",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.13.0",
		"postman-cli": "1.83.0",
		"prettier": "^3.9.10",
		"prisma": "^7.10.1",
		"socket.io-client": "4.8.4",
		"supertest": "^7.3.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"minimatch": "^11.0.3"
	},
	"engines": {
		"node": ">=26.0.0 <27",
		"npm": ">=11"
	}
}
