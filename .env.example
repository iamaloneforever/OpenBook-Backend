# Local development. Never commit a populated .env file.
NODE_ENV=development
PORT=5000

# Used by Prisma and the locally running API. Match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://postgres:replace-with-a-url-encoded-password@localhost:5432/mybook

# Docker Compose database password. Use a random, URL-safe value.
POSTGRES_PASSWORD=

# Generate two independent values with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Exact browser origins, comma separated. No paths, trailing slashes, or wildcards.
CORS_ORIGINS=http://localhost:3000

# Externally reachable API base URL; also trusts this origin for browser writes.
SOCIAL_PUBLIC_URL=http://localhost:5000

# Optional: shared chat delivery and rate limits across API instances.
# Keep Redis private; use rediss:// and authentication for remote deployments.
CHAT_REDIS_URL=

# Open Library works without an API key. Configure Google Books to search both.
GOOGLE_BOOKS_API_KEY=
# Identify your deployment to public catalogs, for example: OpenBook/1.0 (admin@example.com)
BOOK_CATALOG_USER_AGENT=

# Only for isolated integration tests; never point these at real data.
# SOCIAL_TEST_DATABASE_URL=postgresql://test:test@localhost:5432/openbook_social_test
# CHAT_TEST_DATABASE_URL=postgresql://test:test@localhost:5432/openbook_chat_test
# CHAT_TEST_REDIS_URL=redis://localhost:6379/15
# READ_LIST_TEST_DATABASE_URL=postgresql://test:test@localhost:5432/openbook_read_list_test
